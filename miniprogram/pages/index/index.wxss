.index-page { min-height: 100vh; background: #fff; color: #282828; }
.topbar { height: 112rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.96); border-bottom: 1px solid #dedede; position: sticky; top: 0; z-index: 80; }
.brand { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.brand-mark { width: 58rpx; height: 58rpx; background: #fffa00; padding: 8rpx; box-sizing: border-box; }
.brand-mark image { width: 100%; height: 100%; }
.brand-cn { font-size: 26rpx; line-height: 1.1; font-weight: 800; letter-spacing: .08em; }
.brand-en { color: #797979; font-size: 14rpx; margin-top: 7rpx; }
.status { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 14rpx; border: 1px solid #d8d8d8; font: 700 16rpx var(--font-tech); }
.dot { width: 12rpx; height: 12rpx; background: #a9a9a9; }
.dot.on { background: #fffa00; box-shadow: 0 0 0 4rpx rgba(255,250,0,.22); }
.hero { height: 920rpx; position: relative; overflow: hidden; background: #ebebeb; }
.hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(40,40,40,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(40,40,40,.07) 1px,transparent 1px); background-size: 48rpx 48rpx; }
.hero-landscape { position: absolute; left: 0; right: 0; bottom: 0; width: 100%; height: 310rpx; opacity: .38; filter: grayscale(1); }
.hero-character { position: absolute; width: 910rpx; height: 870rpx; right: -150rpx; bottom: -6rpx; }
.hero-character.is-admin { width: 840rpx; right: -118rpx; bottom: -14rpx; }
.hero-index { position: absolute; top: 30rpx; left: 30rpx; color: #626262; font-size: 17rpx; }
.hero-copy { position: absolute; z-index: 3; left: 30rpx; right: 30rpx; top: 92rpx; }
.hero-kicker { width: 340rpx; font-size: 15rpx; line-height: 1.6; color: #626262; }
.hero-name { margin-top: 18rpx; font-size: 88rpx; line-height: .95; font-weight: 900; letter-spacing: -.08em; }
.hero-name-en { margin-top: 15rpx; font-size: 19rpx; color: #282828; letter-spacing: .2em; }
.hero-rule { width: 118rpx; height: 8rpx; background: #fffa00; margin: 25rpx 0 20rpx; }
.hero-desc { width: 300rpx; color: #626262; font-size: 22rpx; line-height: 1.7; }
.hero-switcher { position: absolute; z-index: 5; right: 24rpx; bottom: 32rpx; display: flex; flex-direction: column; gap: 10rpx; }
.hero-switch { min-width: 190rpx; height: 66rpx; box-sizing: border-box; padding: 0 18rpx; display: flex; align-items: center; gap: 18rpx; background: rgba(255,255,255,.9); border: 1px solid rgba(40,40,40,.25); font-size: 22rpx; font-weight: 700; }
.hero-switch.active { background: #fffa00; border-color: #fffa00; }
.switch-no { font-size: 15rpx; color: #626262; }
.action-dock { min-height: 220rpx; padding: 34rpx 30rpx; box-sizing: border-box; background: #282828; color: #fff; display: flex; align-items: center; justify-content: space-between; }
.action-copy { min-width: 0; }
.action-kicker { color: #fffa00; font-size: 14rpx; }
.action-title { font-size: 38rpx; font-weight: 800; margin-top: 14rpx; letter-spacing: -.03em; }
.action-note { color: #a5a5a5; font-size: 20rpx; margin-top: 12rpx; }
.action-arrow { flex: 0 0 auto; width: 86rpx; height: 86rpx; margin-left: 20rpx; background: #fffa00; color: #282828; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 900; }
.archive-head { background: #fffa00; padding: 50rpx 30rpx 46rpx; }
.archive-code { font-size: 15rpx; color: #626262; }
.archive-title { font-size: 54rpx; line-height: 1.1; font-weight: 900; margin-top: 14rpx; letter-spacing: -.05em; }
.archive-sub { color: #555; font-size: 22rpx; margin-top: 16rpx; }
.search-section { padding: 36rpx 24rpx 60rpx; background: #f4f4f4; }
.search-anchor { position: relative; z-index: 10; }
.command-shell { background: #fff; border: 1px solid #cfcfcf; border-top: 8rpx solid #282828; }
.command-head { min-height: 84rpx; padding: 0 22rpx; border-bottom: 1px solid #dedede; display: flex; align-items: center; justify-content: space-between; }
.mode-tabs { display: flex; align-self: stretch; }
.mode-btn { padding: 0 20rpx; display: flex; align-items: center; color: #858585; font-size: 21rpx; font-weight: 700; border-bottom: 6rpx solid transparent; }
.mode-btn.active { color: #282828; border-bottom-color: #fffa00; }
.mode-note { font-size: 14rpx; color: #888; }
.query-row { min-height: 116rpx; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16rpx; padding: 0 22rpx; }
.query-prefix { color: #282828; font: 900 42rpx var(--font-tech); }
.query-input { height: 86rpx; font-size: 30rpx; font-weight: 700; color: #282828; }
.query-placeholder { color: #aaa; font-weight: 500; }
.enter-key { background: #fffa00; color: #282828; padding: 18rpx 22rpx; font-size: 22rpx; font-weight: 900; }
.search-history { padding: 0 22rpx 24rpx; display: flex; gap: 14rpx; align-items: flex-start; }
.history-label { padding-top: 10rpx; color: #8b8b8b; font-size: 14rpx; }
.history-chips { flex: 1; display: flex; flex-wrap: wrap; gap: 10rpx; }
.history-chip,.history-clear { padding: 8rpx 15rpx; background: #f2f2f2; border: 1px solid #ddd; font-size: 19rpx; }
.history-chip.chip-ask { border-left: 5rpx solid #fffa00; }
.history-clear { color: #888; background: transparent; border-color: transparent; }
.suggest,.sug-empty { position: absolute; top: 100%; left: 0; right: 0; z-index: 30; background: #fff; border: 1px solid #cfcfcf; box-shadow: 0 24rpx 48rpx rgba(0,0,0,.14); }
.suggest { max-height: 480rpx; }
.sug-item { padding: 20rpx 28rpx; border-bottom: 1px solid #eee; font-size: 23rpx; }
.sug-item:active,.sug-item.active { background: #fffa00; }
.sug-hit { background: #fffa00; font-weight: 900; }
.sug-empty { padding: 22rpx 28rpx; color: #888; font-size: 22rpx; }
.query-ready { margin-top: 24rpx; padding: 28rpx; display: flex; gap: 20rpx; align-items: center; background: #fff; border: 1px solid #ddd; }
.ready-mark { width: 16rpx; height: 56rpx; flex: 0 0 auto; background: #fffa00; }
.empty-code { font-size: 15rpx; color: #626262; }
.empty-hint { font-size: 21rpx; color: #282828; margin-top: 7rpx; }
.asset-credit { margin: 0; padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); background: #282828; color: #8d8d8d; border: 0; font-size: 18rpx; }
@media (min-width: 600px) { .hero { height: 720rpx; } .hero-character { right: 0; } .hero-copy { left: 7vw; } .hero-desc { width: 440rpx; } .search-section { padding-left: 9vw; padding-right: 9vw; } }
