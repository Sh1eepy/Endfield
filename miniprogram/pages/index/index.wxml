<!-- 首页：复用 Web 端的终末地角色主视觉，并针对小程序触控适配。 -->
<view class="index-page">
  <view class="topbar">
    <view class="brand">
      <view class="brand-mark"><image src="/assets/images/endfield-logo.png" mode="aspectFit" /></view>
      <view class="brand-copy">
        <view class="brand-cn">终末地资料终端</view>
        <view class="brand-en tech-label">ENDFIELD ARCHIVE</view>
      </view>
    </view>
    <view class="status" aria-label="{{backendText}}">
      <view class="dot {{backendOk ? 'on' : ''}}"></view>
      <text>{{backendOk ? 'ONLINE' : 'OFFLINE'}}</text>
    </view>
  </view>

  <view class="hero">
    <view class="hero-grid"></view>
    <image class="hero-landscape" src="/assets/images/official/landscape.jpg" mode="aspectFill" />
    <image class="hero-character {{heroIndex === 1 ? 'is-admin' : ''}}" src="{{hero.image}}" mode="aspectFit" />
    <view class="hero-index tech-label">{{hero.code}} / 02</view>
    <view class="hero-copy">
      <view class="hero-kicker tech-label">OPERATOR ARCHIVE // 罗德岛工业档案</view>
      <view class="hero-name">{{hero.name}}</view>
      <view class="hero-name-en tech-label">{{hero.nameEn}}</view>
      <view class="hero-rule"></view>
      <view class="hero-desc">{{hero.desc}}</view>
    </view>
    <view class="hero-switcher">
      <view class="hero-switch {{heroIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="switchHero"><text class="switch-no tech-label">01</text><text>佩丽卡</text></view>
      <view class="hero-switch {{heroIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="switchHero"><text class="switch-no tech-label">02</text><text>管理员</text></view>
    </view>
  </view>

  <view class="action-dock">
    <view class="action-copy">
      <view class="action-kicker tech-label">ARKNIGHTS: ENDFIELD / COMMUNITY DATABASE</view>
      <view class="action-title">配方合成与知识问答</view>
      <view class="action-note">{{stats.names}} 条档案已接入 · 实时检索终端</view>
    </view>
    <view class="action-arrow">↘</view>
  </view>

  <view class="archive-head">
    <view class="archive-code tech-label">02 / DATA ACCESS</view>
    <view class="archive-title">查询终末地档案</view>
    <view class="archive-sub">输入物品、设备或问题，进入配方树与知识库。</view>
  </view>

  <view class="search-section" id="search-command">
    <view class="search-anchor">
      <view class="command-shell">
        <view class="command-head">
          <view class="mode-tabs">
            <view class="mode-btn {{mode === 'syn' ? 'active' : ''}}" data-mode="syn" bindtap="switchMode">配方制造</view>
            <view class="mode-btn {{mode === 'ask' ? 'active' : ''}}" data-mode="ask" bindtap="switchMode">知识问答</view>
          </view>
          <view class="mode-note tech-label">{{mode === 'syn' ? 'SYNTHESIS' : 'KNOWLEDGE'}}</view>
        </view>
        <view class="query-row">
          <text class="query-prefix">/</text>
          <input class="query-input" value="{{query}}" placeholder="{{mode === 'syn' ? '输入物品或设备名' : '输入你的问题'}}" placeholder-class="query-placeholder" confirm-type="search" bindinput="onQueryInput" bindconfirm="onSubmit" />
          <view class="enter-key" bindtap="onSubmit">查询</view>
        </view>
        <view class="search-history" wx:if="{{history.length}}">
          <text class="history-label tech-label">RECENT</text>
          <view class="history-chips">
            <view class="history-chip {{item.mode === 'ask' ? 'chip-ask' : ''}}" wx:for="{{history}}" wx:key="q" data-index="{{index}}" bindtap="onHistoryTap">{{item.q}}</view>
            <view class="history-clear" bindtap="onHistoryClear">清除</view>
          </view>
        </view>
      </view>
      <scroll-view class="suggest" wx:if="{{suggestShow && suggest.length}}" scroll-y>
        <view class="sug-item {{suggestActive === sIdx ? 'active' : ''}}" wx:for="{{suggest}}" wx:for-item="sug" wx:for-index="sIdx" wx:key="name" data-name="{{sug.name}}" bindtap="pickSuggestion">
          <text wx:for="{{sug.segs}}" wx:for-item="seg" wx:for-index="segIdx" wx:key="segIdx" class="{{seg.t === 'hit' ? 'sug-hit' : ''}}">{{seg.v}}</text>
        </view>
      </scroll-view>
      <view class="sug-empty" wx:if="{{suggestShow && suggestEmpty}}">没有匹配「{{query}}」的名称</view>
    </view>

    <view class="query-ready">
      <view class="ready-mark"></view>
      <view>
        <view class="empty-code tech-label">{{mode === 'syn' ? 'SYNTHESIS READY' : 'KNOWLEDGE READY'}}</view>
        <view class="empty-hint">{{mode === 'syn' ? '选择物品后展开完整合成链。' : '检索知识库并核对证据来源。'}}</view>
      </view>
    </view>
  </view>

  <view class="asset-credit">游戏美术素材 © 鹰角网络 · 来自终末地官网与官方 WIKI · 非官方社区工具</view>
</view>
