/* pages/ask/ask.wxss — 问答结果页样式（手机竖屏单列 + 工业档案风） */

.ask-page {
  padding: 16px 12px 40px;
  position: relative;
}

/* 背景半透明 q 版小人 */
.bg-mascot {
  position: fixed;
  pointer-events: none;
  opacity: 0.06;
  z-index: 0;
  animation: ask-char-drift 14s ease-in-out infinite alternate;
}

.bg-ask-1 { width: 72px; right: 4%; top: 16%; }
.bg-ask-2 { width: 60px; left: 3%; top: 52%; animation-delay: -5s; }
.bg-ask-3 { width: 82px; right: 10%; top: 76%; animation-delay: -9s; }
.bg-ask-4 { width: 54px; left: 6%; top: 88%; animation-delay: -13s; }
.bg-ask-5 { width: 66px; right: 5%; top: 38%; animation-delay: -7s; }

/* 回答框右上角：不透明小 q 版装饰 */
.deco-mascot {
  position: absolute;
  pointer-events: none;
  z-index: 5;
  opacity: 0.92;
}

.deco-ask {
  width: 62px;
  right: 10px;
  top: 8px;
  transform: rotate(-5deg);
  filter: drop-shadow(3px 4px 0 rgba(23, 55, 209, 0.18));
}

@keyframes ask-char-drift {
  from { transform: translate3d(-6px, -4px, 0) rotate(-3deg); }
  to { transform: translate3d(12px, 8px, 0) rotate(4deg); }
}

/* 内容层压在背景之上 */
.ask-page > view:not(.bg-mascot),
.ask-page > block {
  position: relative;
  z-index: 1;
}

/* 进入动效 */
.ask-head {
  animation: ask-in 0.45s 0.05s ease both;
}

.ask-body {
  animation: ask-up 0.5s 0.16s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes ask-in {
  from { opacity: 0; transform: translateX(-18px); }
  to { opacity: 1; transform: none; }
}

@keyframes ask-up {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}

.ask-head {
  padding: 4px 4px 14px;
}

.ask-query {
  margin-top: 8px;
  font-size: 24px;
  font-weight: 850;
  color: var(--ink);
  letter-spacing: -0.02em;
  line-height: 1.3;
}

.ask-body {
  margin-top: 6px;
  padding: 16px;
}

/* ===== 通用卡片标题 ===== */
.ask-card-title {
  font-size: 16px;
  font-weight: 900;
  color: var(--ink);
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--klein);
  letter-spacing: -0.01em;
}

/* ===== 知识库回退（速览等完整渲染） ===== */
.kb-cat {
  display: inline-block;
  padding: 2px 10px;
  margin-bottom: 10px;
  background: rgba(23, 55, 209, 0.08);
  color: var(--klein);
  border: 1px solid rgba(23, 55, 209, 0.3);
  border-radius: 3px 10px 3px 10px;
  font-size: 9px;
}

.kb-sec {
  margin-top: 10px;
}

.kb-sec-title {
  font-size: 15px;
  font-weight: 900;
  color: var(--ink);
  padding: 6px 0;
  border-left: 4px solid var(--yellow);
  padding-left: 8px;
  margin-bottom: 6px;
}

.kb-para {
  font-size: 13px;
  line-height: 1.7;
  color: var(--text);
  margin: 4px 0;
  padding: 6px 10px;
  border-left: 3px solid #d1d0c8;
  background: rgba(247, 246, 241, 0.8);
  white-space: pre-wrap;
  word-break: break-word;
}

.kb-full-img {
  width: 100%;
  border-radius: 4px;
  margin: 6px 0;
  display: block;
}

.kb-text {
  font-size: 13px;
  line-height: 1.8;
  color: var(--text);
  white-space: pre-wrap;
  word-break: break-word;
}

/* kb 表格（复用 operator 的表格样式） */
.kb-table-wrap {
  margin: 6px 0;
  white-space: nowrap;
}

.kb-table {
  display: table;
  border-collapse: separate;
  border-spacing: 0 4px;
}

.kb-tr {
  display: table-row;
}

.kb-td {
  display: table-cell;
  min-width: 58px;
  max-width: 200px;
  padding: 5px 7px;
  border-top: 1px solid #cfcec5;
  border-bottom: 1px solid #cfcec5;
  background: linear-gradient(105deg, #fff, #f3f2eb);
  font-size: 11.5px;
  color: var(--text);
  white-space: normal;
  word-break: break-all;
  vertical-align: top;
  line-height: 1.45;
}

.kb-td.th {
  background: linear-gradient(100deg, #151812, #2634a1);
  color: #fff !important;
  font-weight: 800;
  white-space: nowrap;
}

.kb-hr {
  height: 1px;
  background: linear-gradient(90deg, #f0cf16, #1737d1, transparent);
  margin: 8px 0;
}

/* ===== 配方 / 设备卡（方形 + 不对称圆角边角） ===== */
.ask-recipe-card {
  border: 1px solid #d7d6ce;
  background: #f8f7f2;
  padding: 12px 14px;
  margin-bottom: 10px;
  border-radius: 4px 16px 4px 16px;
  box-shadow: inset 0 -2px 0 var(--klein), 6px 8px 0 rgba(23, 55, 209, 0.08);
}

.rc-machine {
  font-weight: 800;
  color: #171a15;
  font-size: 14px;
  margin-bottom: 6px;
  letter-spacing: 0.02em;
}

.rc-row {
  font-size: 13px;
  color: var(--text);
  margin-top: 4px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 8px;
}

.rc-label {
  color: var(--accent2);
  font-weight: 700;
  flex: 0 0 auto;
}

.rc-item {
  color: var(--text);
}

/* ===== 设备产物反查 ===== */
.prod-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.prod-chip {
  padding: 6px 12px;
  border: 1px solid #aab1a5;
  background: #f1f3ed;
  color: #31382f;
  font-size: 12px;
  border-radius: 3px 12px 3px 12px;
}

/* ===== 歧义候选 ===== */
.ambig-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ambig-btn {
  padding: 8px 14px;
  border: 1px solid var(--border2);
  background: #fff;
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
  border-radius: 3px 14px 3px 14px;
}

.ambig-btn:active {
  background: var(--yellow);
}

/* ===== 意图标签 ===== */
.ask-tags {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.intent-tag {
  display: inline-flex;
  padding: 3px 11px;
  font-size: 11px;
  background: rgba(240, 207, 22, 0.14);
  color: #796a00;
  border: 1px solid rgba(240, 207, 22, 0.45);
  letter-spacing: 0.06em;
  border-radius: 3px 10px 3px 10px;
}

.intent-tag.tag-blue {
  background: rgba(23, 55, 209, 0.08);
  color: var(--klein);
  border-color: rgba(23, 55, 209, 0.3);
}

/* ===== 答案正文 ===== */
.ask-answer {
  font-size: 15px;
  line-height: 1.8;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* markdown 渲染流：rich-text 段落块与 [来源N] 角标混排 */
.ask-md-flow {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
}

.ask-md {
  display: inline;
  font-size: 15px;
  line-height: 1.8;
  color: var(--ink);
  max-width: 100%;
  word-break: break-word;
}

.ask-rejected {
  color: var(--sub);
  font-style: italic;
}

.src-ref {
  color: var(--klein);
  font-size: 11px;
  vertical-align: super;
  padding: 0 1px;
}

.src-ref-hi {
  color: var(--yellow);
  font-weight: 800;
}

/* ===== 来源 chips ===== */
.ask-sources {
  margin-top: 16px;
  border-top: 1px dashed var(--border);
  padding-top: 12px;
}

.ask-src-title {
  font-size: 9px;
  color: var(--faint);
  margin-bottom: 8px;
}

.src-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.src-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border: 1px solid #aab1a5;
  background: #f1f3ed;
  color: #31382f;
  font-size: 12px;
  border-radius: 3px 12px 3px 12px;
}

.src-chip:active {
  background: var(--ink);
  color: #fff;
}

.src-chip-hi {
  box-shadow: 0 0 0 3px rgba(240, 207, 22, 0.45);
}

.src-chip .rn {
  font-size: 10px;
  opacity: 0.75;
}

/* ===== 检索片段折叠 ===== */
.ask-hits {
  margin-top: 16px;
  border-top: 1px dashed var(--border);
  padding-top: 12px;
}

.hits-title {
  font-size: 9px;
  color: var(--faint);
  margin-bottom: 8px;
}

.hit-item {
  border: 1px solid var(--border);
  background: #f8f7f2;
  padding: 10px 12px;
  margin-bottom: 8px;
}

.hit-head {
  display: flex;
  align-items: baseline;
  gap: 8px;
}

.hit-name {
  color: var(--klein);
  font-weight: 700;
  font-size: 13px;
}

.hit-cat {
  color: var(--faint);
  font-size: 10px;
}

.hit-text {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.7;
  color: var(--text);
}

/* ===== 加载/错误/空 ===== */
.loading-line {
  height: 4px;
  background: linear-gradient(90deg, var(--klein) 0 72%, var(--yellow) 72%);
  animation: loading-pulse 1.4s ease-in-out infinite;
  width: 40%;
}

@keyframes loading-pulse {
  0%, 100% { opacity: 0.4; width: 30%; }
  50% { opacity: 1; width: 70%; }
}

.loading-text {
  margin-top: 14px;
  font-size: 9px;
  color: #867600;
}

.ask-error {
  color: var(--danger);
  font-size: 14px;
}

.empty-code {
  font-size: 10px;
  color: #867600;
}
