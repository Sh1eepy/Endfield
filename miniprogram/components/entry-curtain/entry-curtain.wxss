/* components/entry-curtain/entry-curtain.wxss — 开场动画（SYSTEM BOOT v3：多段动效） */

.curtain {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(132deg, #070908 0 48%, #101522 48% 72%, #151b31 72%);
  overflow: hidden;
  transition: opacity 0.7s ease, transform 0.7s ease;
}

/* 幕布退场：右滑消失 */
.curtain.leaving {
  opacity: 0;
  transform: translateX(100%);
}

.curtain.done {
  display: none;
}

/* ===== 背景层：超大半透明终末地图标（呼吸 + 缓慢旋转） ===== */
.bg-logo {
  position: absolute;
  width: 130vw;
  height: 130vw;
  max-width: 720px;
  max-height: 720px;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.05;
  animation: bg-logo-breathe 6s ease-in-out infinite;
  pointer-events: none;
}

@keyframes bg-logo-breathe {
  0%, 100% { transform: translate(-50%, -50%) scale(1) rotate(-6deg); opacity: 0.045; }
  50% { transform: translate(-50%, -50%) scale(1.08) rotate(6deg); opacity: 0.075; }
}

/* ===== q版小人乱滚（8 个不同，错峰旋转位移缩放） ===== */
.roll-mascot {
  position: absolute;
  pointer-events: none;
  opacity: 0.16;
  animation: roll 9s linear infinite;
}

.roll-1 { width: 46px; left: 4%;  top: 10%; animation-duration: 7s;  animation-delay: -0.5s; }
.roll-2 { width: 40px; right: 6%; top: 8%;  animation-duration: 9s;  animation-delay: -2s; }
.roll-3 { width: 54px; left: 12%; top: 22%; animation-duration: 8s;  animation-delay: -3.5s; }
.roll-4 { width: 36px; right: 14%; top: 26%; animation-duration: 10s; animation-delay: -1.2s; }
.roll-5 { width: 60px; left: 6%;  bottom: 18%; animation-duration: 8.5s; animation-delay: -4.5s; }
.roll-6 { width: 42px; right: 8%; bottom: 12%; animation-duration: 9.5s; animation-delay: -6s; }
.roll-7 { width: 50px; left: 20%; bottom: 8%; animation-duration: 7.5s; animation-delay: -2.8s; }
.roll-8 { width: 38px; right: 22%; bottom: 24%; animation-duration: 11s; animation-delay: -5.5s; }

/* 乱滚：旋转 + 位移 + 缩放（不同小人用不同轨迹微调） */
@keyframes roll {
  0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
  25%  { transform: translate(14px, -10px) rotate(120deg) scale(1.12); }
  50%  { transform: translate(-9px, 9px) rotate(240deg) scale(0.9); }
  75%  { transform: translate(11px, 7px) rotate(300deg) scale(1.06); }
  100% { transform: translate(0, 0) rotate(360deg) scale(1); }
}

/* roll-4/6/8 反向滚（差异化） */
.roll-4, .roll-6, .roll-8 {
  animation-name: roll-rev;
}

@keyframes roll-rev {
  0%   { transform: translate(0, 0) rotate(0deg) scale(1); }
  25%  { transform: translate(-12px, 9px) rotate(-120deg) scale(1.08); }
  50%  { transform: translate(10px, -8px) rotate(-240deg) scale(0.92); }
  75%  { transform: translate(-9px, -6px) rotate(-300deg) scale(1.05); }
  100% { transform: translate(0, 0) rotate(-360deg) scale(1); }
}

/* ===== 机械构件层 ===== */
.mechanism {
  position: relative;
  width: 82vw;
  max-width: 460px;
  z-index: 2;
}

/* 多段动效：背景斜纹光束 */
.beam {
  position: absolute;
  inset: -10%;
  background: repeating-linear-gradient(116deg, transparent 0 82px, rgba(255, 255, 255, 0.035) 83px 84px);
  animation: grid-drift 8s linear infinite;
}

.beam-b {
  background: linear-gradient(116deg, transparent 44%, rgba(23, 55, 209, 0.22) 44.2% 47%, transparent 47.2%);
}

@keyframes grid-drift {
  from { transform: translateX(0); }
  to { transform: translateX(40px); }
}

/* 多段动效：垂直扫描线（自上而下反复扫） */
.scan-line {
  position: absolute;
  left: -8%;
  right: -8%;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(240, 207, 22, 0.5), transparent);
  box-shadow: 0 0 12px rgba(240, 207, 22, 0.3);
  animation: scan-line 2.2s ease-in-out infinite;
  top: 0;
}

@keyframes scan-line {
  0% { top: -2%; opacity: 0; }
  8% { opacity: 0.9; }
  92% { opacity: 0.9; }
  100% { top: 102%; opacity: 0; }
}

/* 左右轨道 */
.rail {
  position: absolute;
  top: -14%;
  bottom: -14%;
  width: 3px;
  background: linear-gradient(180deg, transparent, rgba(240, 207, 22, 0.5), transparent);
}

.rail-left { left: 8%; }
.rail-right { right: 8%; }

/* ===== 阶段容器：整体错峰入场 ===== */
.stage {
  animation: stage-in 0.7s 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes stage-in {
  from { opacity: 0; transform: translateY(26px) scale(0.96); }
  to { opacity: 1; transform: none; }
}

/* logo 板：斜切 + 双投影 + 机械锁定（滑入 + 落定震颤） */
.logo-plate {
  position: relative;
  width: 76%;
  margin: 0 auto;
  aspect-ratio: 1.4 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #fff 0 72%, #e8e7df 72%);
  border-radius: 6px;
  box-shadow: 18px 20px 0 rgba(23, 55, 209, 0.74), -14px -12px 0 rgba(240, 207, 22, 0.88);
  animation: dock-in 1s 0.75s cubic-bezier(0.16, 0.92, 0.22, 1.05) both,
             dock-settle 0.6s 1.8s ease both;
}

.logo-plate image {
  width: 78%;
  height: 78%;
  animation: logo-sweep 1.2s 2s ease forwards;
}

/* 机械锁定角块 */
.logo-lock {
  position: absolute;
  width: 16px;
  height: 16px;
  background: #1737d1;
  clip-path: polygon(0 0, 100% 0, 100% 100%);
  opacity: 0;
  animation: lock-in 0.35s 1.8s ease both;
}

.logo-lock.lock-l { left: -6px; top: -6px; }
.logo-lock.lock-r { right: -6px; bottom: -6px; transform: rotate(180deg); }

@keyframes lock-in {
  from { opacity: 0; transform: scale(0.4); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes dock-in {
  from { opacity: 0; transform: translateX(-70px) rotate(-16deg) scale(0.66); }
  to { opacity: 1; transform: none; }
}

@keyframes dock-settle {
  0% { transform: translateY(0) rotate(0); }
  35% { transform: translateY(-5px) rotate(-0.6deg); }
  70% { transform: translateY(2px) rotate(0.4deg); }
  100% { transform: translateY(0) rotate(0); }
}

/* logo 扫光 */
@keyframes logo-sweep {
  0% { clip-path: inset(0 100% 0 0); }
  100% { clip-path: inset(0 0 0 0); }
}

/* 进度区 */
.boot {
  width: 82%;
  margin: 26px auto 0;
  color: #fff;
  animation: boot-in 0.55s 1.15s ease both;
}

@keyframes boot-in {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: none; }
}

.boot-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 8px;
}

.boot-label {
  font-size: 9px;
  letter-spacing: 0.16em;
  color: rgba(255, 255, 255, 0.64);
  font-family: monospace;
}

.boot-percent {
  font-size: 30px;
  font-weight: 800;
  line-height: 0.9;
  color: #f0cf16;
  font-family: monospace;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 0 14px rgba(240, 207, 22, 0.5);
}

.progress {
  position: relative;
  height: 14px;
  padding: 2px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.38);
  border-radius: 2px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1737d1 0 72%, #f0cf16 72%);
  box-shadow: 0 0 16px rgba(240, 207, 22, 0.4);
  transition: width 0.09s linear;
  position: relative;
}

/* 进度条前沿光点 */
.progress-glow {
  position: absolute;
  top: -2px;
  bottom: -2px;
  width: 22px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(240, 207, 22, 0.85), transparent);
  filter: blur(2px);
  animation: glow-flicker 0.5s ease-in-out infinite;
  transition: left 0.09s linear;
  pointer-events: none;
}

@keyframes glow-flicker {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.ticks {
  height: 7px;
  margin-top: 6px;
  background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.28) 0 1px, transparent 1px 5%);
}

.boot-status {
  margin-top: 12px;
  text-align: center;
  animation: ok-in 0.4s ease both;
}

.boot-ok {
  display: block;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.22em;
  color: #b7ef58;
  font-family: monospace;
  text-shadow: 0 0 12px rgba(183, 239, 88, 0.55);
}

.boot-sub {
  display: block;
  margin-top: 5px;
  font-size: 8px;
  color: rgba(255, 255, 255, 0.5);
}

@keyframes ok-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}
