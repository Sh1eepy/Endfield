/* 小程序全局视觉：与当前 Web 端统一的终末地黄黑工业档案系统。 */
page {
  --bg: #f4f4f4;
  --card: #ffffff;
  --panel: #eeeeee;
  --panel2: #e5e5e5;
  --border: #d8d8d8;
  --border2: #bdbdbd;
  --accent: #fffa00;
  --accent2: #282828;
  --accent3: #777300;
  --text: #282828;
  --sub: #626262;
  --faint: #929292;
  --ink: #282828;
  --paper: #ffffff;
  --yellow: #fffa00;
  --klein: #282828;
  --klein-soft: rgba(40, 40, 40, 0.1);
  --depth: #c8c8c8;
  --ok: #8ea600;
  --danger: #c73b32;
  --font-cn: "Endfield CN", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-tech: "Endfield Tech", "Courier New", Consolas, monospace;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-cn);
  font-size: 30rpx;
  line-height: 1.55;
}

.poly-panel {
  position: relative;
  background: #fff;
  border: 1px solid #d4d4d4;
  border-top: 8rpx solid #282828;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.07);
}
.poly-panel::after { display: none; }
.tech-label { font-family: var(--font-tech); font-size: 20rpx; letter-spacing: .14em; color: var(--faint); text-transform: uppercase; }
.tech-label b { color: var(--yellow); font-weight: 800; }
.yellow-strip { position: absolute; left: -1px; top: -8rpx; width: 120rpx; height: 8rpx; background: var(--yellow); }
.poly-btn { border: 1px solid var(--ink); background: var(--ink); color: #fff; padding: 20rpx 28rpx; font-family: var(--font-tech); font-weight: 700; font-size: 22rpx; letter-spacing: .1em; }
.poly-btn-secondary { background: transparent; color: var(--ink); }
.chip { display: inline-flex; align-items: center; padding: 8rpx 20rpx; font-size: 24rpx; border: 1px solid var(--border2); background: var(--card); color: var(--sub); }
.chip-yellow { background: var(--yellow); border-color: var(--yellow); color: var(--ink); font-weight: 700; }
.asset-credit { margin: 56rpx 30rpx 34rpx; padding-top: 22rpx; border-top: 1px solid #d7d7d7; color: var(--sub); font-size: 20rpx; line-height: 1.6; text-align: center; }

@keyframes scanline-move { 0%,100% { transform: translateX(-35%); opacity: .15; } 50% { transform: translateX(35%); opacity: .8; } }
@media (prefers-reduced-motion: reduce) { page,view,image,text { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
