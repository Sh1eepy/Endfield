/* app.wxss — 全局主题（对齐网页端 v5-v7 白色工业档案风）
   关键 token：
   --klein 克莱因蓝 #1737D1（表格边缘/立体投影/主强调）
   --yellow 工业黄 #F0CF16（斜切标记/标签/按钮高亮）
   --bg 米白底 #F5F4EE / 深墨 --ink #111310
   多边形轮廓、立体投影、等宽字体族统一在此定义，页面组件复用。
*/
page {
  /* ===== 配色 token ===== */
  --bg: #f5f4ee;
  --card: #ffffff;
  --panel: #f0efe8;
  --panel2: #e7e6df;
  --border: #d5d4cc;
  --border2: #aaa99f;
  --accent: #f0cf16;
  --accent2: #232722;
  --accent3: #796a00;
  --text: #171916;
  --sub: #61665d;
  --faint: #969a91;
  --ink: #111310;
  --paper: #ffffff;
  --yellow: #f0cf16;
  --klein: #1737d1;
  --klein-soft: rgba(23, 55, 209, 0.18);
  --depth: #b8b5a8;
  --ok: #6da900;
  --danger: #ff6b57;

  /* ===== 字体 ===== */
  --font-cn: "Endfield CN", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-tech: "Endfield Tech", "Courier New", Consolas, monospace;

  background: var(--bg);
  color: var(--text);
  font-family: var(--font-cn);
  font-size: 15px;
  line-height: 1.55;
  /* 米白底 + 网格线 + 右上角工业黄光晕 */
  background-image:
    linear-gradient(90deg, rgba(20, 24, 19, 0.055) 1px, transparent 1px),
    linear-gradient(rgba(20, 24, 19, 0.045) 1px, transparent 1px),
    radial-gradient(circle at 82% 6%, rgba(240, 207, 22, 0.2), transparent 29%);
  background-size: 72px 72px, 72px 72px, auto;
  background-repeat: repeat, repeat, no-repeat;
}

/* ===== 通用：方形面板 + 边角图形化（不对称圆角 + 克莱因蓝投影） =====
   主体为正常方形（不裁切内容），边角用不对称圆角做奇妙图形化：
   左上/右下小圆角，右上/左下大圆角（呼应网页 v4 kinetic shape language）。
*/
.poly-panel {
  position: relative;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid #bdbbb1;
  border-radius: 5px 22px 5px 22px; /* 方形主体 + 不对称边角 */
  /* 克莱因蓝偏移投影 + 柔和阴影（对齐网页 v5） */
  box-shadow:
    inset -1px -1px 0 var(--klein),
    8px 10px 0 var(--klein-soft),
    18px 22px 24px rgba(25, 28, 22, 0.1);
}

/* 面板内描边（随边角圆角，对齐网页 .command-shell::after 效果） */
.poly-panel::after {
  content: "";
  position: absolute;
  inset: 7px;
  border: 1px solid rgba(23, 55, 209, 0.16);
  border-radius: 3px 18px 3px 18px;
  pointer-events: none;
}

/* ===== 通用：等宽小标签（工业风） ===== */
.tech-label {
  font-family: var(--font-tech);
  font-size: 10px;
  letter-spacing: 0.18em;
  color: var(--faint);
  text-transform: uppercase;
}

.tech-label b {
  color: var(--yellow);
  font-weight: 800;
}

/* ===== 通用：工业黄顶部条 ===== */
.yellow-strip {
  position: absolute;
  left: -1px;
  top: -1px;
  width: 82px;
  height: 4px;
  background: var(--yellow);
}

/* ===== 通用：方形按钮（不对称圆角边角） ===== */
.poly-btn {
  border: 1px solid var(--ink);
  background: var(--ink);
  color: #fff;
  padding: 11px 16px;
  font-family: var(--font-tech);
  font-weight: 700;
  font-size: 12px;
  letter-spacing: 0.12em;
  border-radius: 3px 14px 3px 14px;
  transition: transform 0.2s, box-shadow 0.2s;
}

.poly-btn::after {
  content: "";
  position: absolute;
}

.poly-btn-secondary {
  background: transparent;
  color: var(--ink);
}

/* ===== 通用：胶囊 / 斜切 chip ===== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 4px 12px;
  font-size: 13px;
  border: 1px solid var(--border2);
  background: var(--card);
  color: var(--sub);
}

.chip-yellow {
  background: var(--yellow);
  border-color: #bfa700;
  color: var(--ink);
  font-weight: 700;
}

/* 页面素材署名：保持可读但不抢占内容层级。 */
.asset-credit {
  margin: 36px 20px 24px;
  padding-top: 14px;
  border-top: 1px solid rgba(23, 55, 209, 0.22);
  color: var(--sub);
  font-family: var(--font-cn);
  font-size: 12px;
  line-height: 1.6;
  text-align: center;
  letter-spacing: 0.03em;
}

/* ===== 通用：扫描线动画（空状态） ===== */
@keyframes scanline-move {
  0%, 100% { transform: translateX(-35%); opacity: 0.15; }
  50% { transform: translateX(35%); opacity: 0.8; }
}

/* ===== 通用：内容入场 ===== */
@keyframes content-in {
  from { opacity: 0; transform: translateY(12px); filter: blur(3px); }
  to { opacity: 1; transform: none; filter: none; }
}

/* ===== 通用：减少动态效果 ===== */
@media (prefers-reduced-motion: reduce) {
  page, view, image, text {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
