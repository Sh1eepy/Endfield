# ============================================================
# .env.example — 环境变量模板（复制为 .env 后填写真实值）
# ⚠️ .env 已被 .gitignore 排除，禁止提交真实密钥到 git
# ============================================================

# ---- 在线 LLM（RAG 问答助手用，OpenAI 兼容协议）----
# 必填：服务商 API 密钥（DeepSeek/通义/Kimi/OpenAI 均可）
LLM_API_KEY=

# 可选：API 端点（不填则按模型名自动猜，如 deepseek-chat → deepseek）
# 常用值：
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi:     https://api.moonshot.cn/v1
#   OpenAI:   https://api.openai.com/v1
LLM_BASE_URL=

# 可选：模型名（默认 deepseek-chat）
LLM_MODEL=

# 可选：超时秒数（默认 60）
# LLM_TIMEOUT=60

# ---- 其他备用配置 ----
# （留空即可）
