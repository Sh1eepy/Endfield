# ============================================================
# .env.example — 环境变量模板（复制为 .env 后填写真实值）
# ⚠️ .env 已被 .gitignore 排除，禁止提交真实密钥到 git
# ============================================================

# ---- 在线 LLM（RAG 问答助手用，OpenAI 兼容协议）----
# 必填：服务商 API 密钥（DeepSeek/通义/Kimi/OpenAI 均可）
LLM_API_KEY=

# 可选：API 端点（不填则按模型名自动猜，如 deepseek-chat → deepseek）
# 常用值：
#   DeepSeek: https://api.deepseek.com/v1
#   通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi:     https://api.moonshot.cn/v1
#   OpenAI:   https://api.openai.com/v1
LLM_BASE_URL=

# 可选：模型名（默认 deepseek-chat）
LLM_MODEL=

# 可选：超时秒数（默认 60）
# LLM_TIMEOUT=60

# ---- 服务并发保护 ----
# 首次上线保持单 worker；每个 worker 都会独立加载 embedding 模型和索引
WEB_CONCURRENCY=1

# 每个 worker 同时执行的知识问答上限；超出时 /api/ask 返回 HTTP 429
ASK_MAX_CONCURRENCY=2

# 问答准入：UTC 固定分钟/日期窗口，所有 worker 共享 SQLite 计数
ASK_RATE_PER_MINUTE=6
ASK_IP_DAILY_LIMIT=60
ASK_DAILY_LIMIT=200
# 默认 logs/api-security/ask-budget.sqlite3；Compose 自动使用持久卷内路径
# ASK_BUDGET_DB=/persistent/path/ask-budget.sqlite3

# 可选私有访问令牌：设置后 /api/ask 必须携带 Authorization: Bearer <token>
# 留空 = 有限额的匿名服务，不是登录鉴权。不要填 LLM_API_KEY，也不要放进公开前端。
API_ACCESS_TOKEN=

# 每个 worker 最多同时下载/发送的媒体响应数；单文件最大 25 MiB
MEDIA_MAX_CONCURRENCY=2

# Uvicorn 仅信任这些反向代理的转发头；禁止填 *。
# 留空最保守：同一代理后的访问者会共享应用 IP 限额；Nginx 仍按真实客户端 IP 限流。
# Docker 需填写容器实际看到的 Nginx 对端 IP；参见 deploy/API_SECURITY.md。
# 由 scripts/start_server.py 启动时自动从本文件读取并传给 uvicorn。
FORWARDED_ALLOW_IPS=

# ---- 其他备用配置 ----
# （留空即可）
